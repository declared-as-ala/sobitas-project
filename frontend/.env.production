# Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* variables are BAKED INTO the client-side JS bundle at build
# time (next build). They cannot be overridden at runtime for browser code.
# Server-side variables (API_BACKEND_URL, STORAGE_BACKEND_URL) ARE read at
# runtime from the container environment.
#
# CRITICAL RULE: NEXT_PUBLIC_STORAGE_URL must be the same URL that the
# Docker runtime env also sets, so SSR and the client bundle produce
# identical image src attributes — preventing React hydration mismatches.
# ─────────────────────────────────────────────────────────────────────────────

# ── Client-side (baked at build time) ────────────────────────────────────────
# Browser sends API requests through the Next.js /api-proxy rewrite (CORS-safe,
# same origin from the browser's perspective).
NEXT_PUBLIC_API_URL=https://protein.tn/api-proxy

# Storage images are served directly from the Laravel backend.
# Using the direct URL (not a proxy) eliminates the SSR/client hydration
# mismatch that caused images to disappear after React hydration.
NEXT_PUBLIC_STORAGE_URL=https://admin.protein.tn/storage

# ── Server-side (runtime, used by Next.js rewrites & server components) ───────
# The Next.js server proxies /api-proxy/* to this URL.
# Use the internal Docker service name to avoid going through the public internet.
API_BACKEND_URL=http://backend-nginx-v2/api

# Storage: same direct backend URL so server and client generate identical paths.
# (The /storage-proxy rewrite is kept for backward compat but images now use
# the direct URL, so this is only a fallback.)
STORAGE_BACKEND_URL=http://backend-nginx-v2/storage
