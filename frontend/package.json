{
  "name": "protein-tn-frontend",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS=--no-deprecation next dev",
    "prebuild": "node scripts/check-reserved-routes.mjs && node scripts/check-url-contract.mjs && node scripts/check-commercial-intent-map.mjs && node scripts/check-sitemap-routes.mjs && node --experimental-strip-types --no-warnings scripts/check-sitemap-crawl.mjs && node --experimental-strip-types --no-warnings scripts/check-category-seo-content.ts",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "node scripts/assert-no-dev-bundle.mjs",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 999",
    "lint:design": "node scripts/lint-design.mjs",
    "lint:design:update": "node scripts/lint-design.mjs --update",
    "verify": "npm run lint && npm run typecheck && npm run lint:design && npm run build",
    "typecheck": "node scripts/ensure-next-types.mjs && tsc --noEmit",
    "audit:pdp": "node scripts/audit-pdp-content.mjs",
    "measure:pdp": "node scripts/measure-pdp.mjs",
    "check:seams": "node scripts/check-seams.mjs",
    "audit:pdp:update": "node scripts/audit-pdp-content.mjs --update",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "check:overlay-contrast": "node scripts/check-overlay-contrast.mjs",
    "measure:auth": "node scripts/measure-auth.mjs",
    "measure:cart": "node scripts/measure-cart.mjs",
    "measure:account": "node scripts/measure-account.mjs",
    "measure:reviews": "node scripts/measure-reviews.mjs",
    "stub:api": "node scripts/stub-api.mjs",
    "audit:bands": "node scripts/measure-bands.mjs",
    "audit:console": "node scripts/check-console.mjs",
    "snap": "node scripts/visual-snap.mjs",
    "snap:region": "node scripts/snap-region.mjs",
    "verify-seo": "node scripts/verify-seo.js",
    "check:sitemap-routes": "node scripts/check-sitemap-routes.mjs",
    "check:sitemap-crawl": "node --experimental-strip-types --no-warnings scripts/check-sitemap-crawl.mjs",
    "seo-audit-category": "node scripts/seo-audit-category.js",
    "check:url-contract": "node scripts/check-url-contract.mjs",
    "check:indexability": "node scripts/check-indexability-live.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tabs": "1.1.3",
    "axios": "^1.13.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.6.0",
    "isomorphic-dompurify": "^3.19.0",
    "lucide-react": "0.487.0",
    "motion": "^12.43.0",
    "next": "^15.1.6",
    "next-themes": "0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "7.55.0",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "^15.1.6",
    "lighthouse": "^12.8.2",
    "postcss": "^8.4.47",
    "puppeteer": "^24.36.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
