# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# exclude old frontend and backend
/old frontend/
/backend/

# scratch / dev test scripts
/scratch/

# Visual-regression screenshots from scripts/visual-snap.mjs — local review artefacts, never committed.
/.snap/

# Lighthouse reports from scripts/perf.mjs — machine-specific, regenerate locally
.perf/

# Full per-product dump from scripts/audit-pdp-content.mjs --json. The committed artefact is
# pdp-content-baseline.json (the ratchet); this is the working detail behind one run.
/pdp-audit.json
.next-prod/
.next-verify/
