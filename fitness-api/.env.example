# NestJS API Port
PORT=4000

# Database URL
# For local development (connecting to the Docker MySQL container port 3307):
DATABASE_URL="mysql://laravel:secret@127.0.0.1:3307/protein_db"
# For Docker network container:
# DATABASE_URL="mysql://laravel:secret@mysql:3306/protein_db"

# Redis Config
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# For Docker network container:
# REDIS_HOST=redis
# REDIS_PORT=6379

# Google Gemini API Key (fallback provider if GROQ_API_KEY is not set)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Groq API Key (primary AI Coach provider - https://console.groq.com/keys)
GROQ_API_KEY="YOUR_GROQ_API_KEY"
# Groq vision model used for meal-scan photo analysis
GROQ_VISION_MODEL="llama-3.2-11b-vision-preview"

# General Config
NODE_ENV=development
