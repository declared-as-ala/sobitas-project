APP_NAME="Protéine Tunisie"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.protein.tn

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=contact@protein.tn
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO=contact@protein.tn
MAIL_REPLY_TO_NAME="Protein.tn"
ADMIN_EMAILS=contact@protein.tn

# Production notifications. Set real values in the VPS .env; never commit them.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_ORDER_STATUSES=en_cours_de_livraison,livree

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FLARE_KEY=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# API rate limiting (see config/app.php -> api_rate_limit)
# ---------------------------------------------------------------------------
# Read-only GET/HEAD per minute, keyed by user id or IP. The Next.js renderer
# calls this API from a single VPS IP for the whole storefront, so the old flat
# 60/min capped the site at ~1 page render per second under crawl load.
# API_RATE_LIMIT_READ=600
#
# Writes (POST/PUT/PATCH/DELETE) per minute. UNCHANGED from the historical 60 —
# orders, coupons, contact and newsletter keep exactly today's ceiling.
# API_RATE_LIMIT_WRITE=60

# ── Sign in with Google (optional) ───────────────────────────────────────────
# The SAME OAuth 2.0 Web-application client id the storefront uses as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. Public by design; there is no client secret in
# this flow — the browser gets a signed ID token from Google and the API
# verifies its signature and audience server-side.
# Unset: POST /api/auth/google answers 503 and no button renders. Nothing else changes.
GOOGLE_CLIENT_ID=

# ── Storefront URL ───────────────────────────────────────────────────────────
# Where customer-facing links in emails point (password reset, review request).
# Falls back to APP_URL, which is the ADMIN host — so leaving this unset mails
# customers a link to admin.protein.tn.
FRONTEND_URL=https://protein.tn
