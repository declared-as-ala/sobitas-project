# frontend-2: API and storage point to admin.sobitas.tn
# Copy to .env.local for local dev. CI passes these as build-args.

# Client-side (baked at build time)
NEXT_PUBLIC_API_URL=https://admin.sobitas.tn/api
NEXT_PUBLIC_STORAGE_URL=https://admin.sobitas.tn/storage
NEXT_PUBLIC_BASE_URL=https://sobitas.tn

# Server-side rewrites (next.config.js)
API_BACKEND_URL=https://admin.sobitas.tn/api
STORAGE_BACKEND_URL=https://admin.sobitas.tn/storage
